{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthysure-bd",
  "main": "src/worker.js",
  "account_id": "5872d5401e2adbc0f07cae29fe081a6f",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthysure-bd",
      "database_id": "de6bff46-4585-4833-9953-201f58172c74",
      "migrations_dir": "migrations"
    }
  ],
  // REQUIRED in production: values from your Cloudflare Access application. The Worker fails
  // closed (HTTP 500 "Auth not configured") until both are set, and then rejects any request
  // (pages, data file, API) without a valid Access JWT.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
