{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthysure-bd",
  "main": "src/worker.js",
  "account_id": "5872d5401e2adbc0f07cae29fe081a6f",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthysure-bd",
      "database_id": "de6bff46-4585-4833-9953-201f58172c74",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-in: emailed one-time code via SendGrid. Secrets are NOT stored here; set them in
  // Cloudflare (Worker -> Settings -> Variables and Secrets -> Add, type "Secret"):
  //   SESSION_SECRET   random string, 32+ characters (signs login cookies)
  //   SENDGRID_API_KEY SendGrid API key with "Mail Send" permission
  "vars": {
    "ALLOWED_EMAIL_DOMAINS": "bharatsure.com",
    "ALLOWED_EMAILS": "",
    "EMAIL_FROM": "noreply@product.bharatsure.com",
    "EMAIL_FROM_NAME": "HealthySure BD"
  }
}
